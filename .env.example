# Ambiente objetivo: dev | qa | prod
# Default: prod (único live hoy)
TEST_ENV=prod

# --- Overrides opcionales ---
# Genéricos de la corrida (útil en CI cuando elegís un solo env):
# UI_BASE_URL=https://qa.tu-dominio.interno
# API_BASE_URL=https://api.qa.tu-dominio.interno

# Por ambiente (recomendado en secrets de GitHub Environments):
# QA_UI_BASE_URL=
# QA_API_BASE_URL=
# DEV_UI_BASE_URL=
# DEV_API_BASE_URL=
# PROD_UI_BASE_URL=
# PROD_API_BASE_URL=

# Legacy (solo aplican si TEST_ENV=prod):
# BASE_URL=https://www.centraldepasajes.com.ar
# SWAPI_BASE_URL=https://www.swapi.tech/api

API_MAX_RESPONSE_MS=5000
