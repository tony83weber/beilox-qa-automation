{
  "name": "beilox-qa-automation-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Challenge técnico Beilox — QA Automation Senior (Playwright + TypeScript)",
  "scripts": {
    "test": "playwright test",
    "test:ui": "playwright test --project=ui-chromium --project=ui-firefox --project=ui-webkit --project=ui-mobile-chromium",
    "test:ui:chromium": "playwright test --project=ui-chromium",
    "test:ui:firefox": "playwright test --project=ui-firefox",
    "test:ui:webkit": "playwright test --project=ui-webkit",
    "test:ui:mobile": "playwright test --project=ui-mobile-chromium",
    "test:api": "playwright test --project=api",
    "report": "playwright show-report",
    "report:allure": "allure generate allure-results --clean -o allure-report && allure open allure-report",
    "report:allure:generate": "allure generate allure-results --clean -o allure-report",
    "report:allure:serve": "allure serve allure-results",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.4",
    "ajv": "^8.20.0",
    "allure-commandline": "^2.46.1",
    "allure-js-commons": "^3.13.0",
    "allure-playwright": "^3.13.0",
    "dotenv": "^18.0.5",
    "typescript": "^5.8.3"
  }
}
